# ─── Sanity CMS ──────────────────────────────────────────────
# Create a project at https://www.sanity.io
NEXT_PUBLIC_SANITY_PROJECT_ID="your-project-id"
NEXT_PUBLIC_SANITY_DATASET="production"
NEXT_PUBLIC_SANITY_API_VERSION="2024-01-01"
# Generate tokens in Sanity → API → Tokens
SANITY_API_READ_TOKEN="your-sanity-read-token"
SANITY_API_WRITE_TOKEN="your-sanity-write-token"
CRON_SECRET="your-secure-cron-secret-key"

# ─── Cloudflare Email Routing & Contact ──────────────────────
# Sender address on your Cloudflare-routed domain (forwarded via Cloudflare Email Routing / email-worker)
CONTACT_FROM_EMAIL="contact@victoriareindale.com"
# Verified destination inbox in Cloudflare Email Routing
CONTACT_DESTINATION_EMAIL="victoriareindale@gmail.com"

# ─── Cloudflare Turnstile (Anti-Bot) ─────────────────────────
NEXT_PUBLIC_TURNSTILE_SITE_KEY="your-turnstile-site-key"
TURNSTILE_SECRET_KEY="your-turnstile-secret-key"

# ─── Site ────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL="https://victoriareindalesoprano.com"

# ─── Admin Dashboard ─────────────────────────────────────────
ADMIN_PASSWORD="your-secure-admin-password"
