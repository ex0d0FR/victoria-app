# ─── Sanity ──────────────────────────────────────────────────
# Create a project at https://www.sanity.io
NEXT_PUBLIC_SANITY_PROJECT_ID="your-project-id"
NEXT_PUBLIC_SANITY_DATASET="production"
NEXT_PUBLIC_SANITY_API_VERSION="2024-01-01"
# Generate a read token in Sanity → API → Tokens
SANITY_API_READ_TOKEN="your-sanity-read-token"

# ─── Stripe ──────────────────────────────────────────────────
# Keys from https://dashboard.stripe.com/test/apikeys
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."
STRIPE_SECRET_KEY="sk_test_..."
# Webhook secret from Stripe CLI or dashboard
STRIPE_WEBHOOK_SECRET="whsec_..."

# ─── Resend (email) ──────────────────────────────────────────
# Get your key at https://resend.com
RESEND_API_KEY="re_..."
# The email address that receives contact form submissions
CONTACT_EMAIL="victoria@yourdomainhere.com"

# ─── Site ────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL="https://victoriareindalesoprano.com"
